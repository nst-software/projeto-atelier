---
import BaseLayout from "../layouts/BaseLayout.astro";
import Contact from "../components/FaleConosco/Contact.astro";
import LocationBlock from "../components/FaleConosco/LocationBlock.astro";
import { siteConfig } from "../config/site";
---

<BaseLayout
  title="Fale Conosco"
  description="Entre em contato para mais informações: e-mail, telefone, WhatsApp e os endereços da nossa loja e da nossa produção."
>
  <Contact />
  <LocationBlock location={siteConfig.locations.store} showWhatsapp />
  <LocationBlock location={siteConfig.locations.production} />
</BaseLayout>
