---
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CatalogoCompleto from "../../components/Catalogo/CatalogoCompleto.astro";
import PrintGrid from "../../components/Catalogo/PrintGrid.astro";
import { siteConfig } from "../../config/site";

export const getStaticPaths = (async () => {
  const categories = await getCollection("catalog");
  return categories.map((category) => ({ params: { slug: category.id }, props: { category } }));
}) satisfies GetStaticPaths;

interface Props {
  category: CollectionEntry<"catalog">;
}

const { category } = Astro.props;
const { name, cover } = category.data;
---

<BaseLayout
  title={name}
  description={`Estampas da categoria ${name} do catálogo ${siteConfig.name}.`}
  image={cover}
>
  <h1 class="mt-8 text-center text-3xl uppercase">{name}</h1>
  <CatalogoCompleto />
  <PrintGrid category={category} />
</BaseLayout>
