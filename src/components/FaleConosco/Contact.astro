---
import { siteConfig } from "../../config/site";
import Call from "../icons/Call.astro";
import Email from "../icons/Email.astro";
import Button from "../ui/Button.astro";
import PageTitle from "../ui/PageTitle.astro";
---

<section class="mx-auto flex w-full max-w-screen-lg flex-col items-start gap-3 px-4 pt-8 sm:px-8">
  <PageTitle>Contato</PageTitle>
  <p class="flex items-center gap-2 text-lg">
    <Email class="size-5 shrink-0" />
    <span>
      E-mail: <a href={`mailto:${siteConfig.email}`} class="underline-offset-2 hover:text-brand-red hover:underline">{siteConfig.email}</a>
    </span>
  </p>
  <p class="flex items-center gap-2 text-lg">
    <Call class="size-5 shrink-0" />
    <span>
      Telefone: <a href={`tel:${siteConfig.landline.tel}`} class="underline-offset-2 hover:text-brand-red hover:underline">{siteConfig.landline.display}</a>
    </span>
  </p>
  <Button href={siteConfig.whatsapp.url} class="mt-2">
    <Call class="size-6" />
    Contato
  </Button>
</section>
