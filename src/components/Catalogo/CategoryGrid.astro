---
import type { CollectionEntry } from "astro:content";
import { COVER_WIDTHS } from "../../lib/images";
import Card from "../ui/Card.astro";
import CatalogImage from "./CatalogImage.astro";

interface Props {
  categories: CollectionEntry<"catalog">[];
}

const { categories } = Astro.props;
const EAGER_COUNT = 3;
const sizes = "(min-width: 900px) 360px, (min-width: 600px) 45vw, 50vw";
---

<ul class="mx-auto grid w-full max-w-6xl grid-cols-2 gap-3 px-4 pb-12 sm:gap-4 md:grid-cols-3 md:gap-6">
  {
    categories.map(({ id, data }, index) => (
      <li>
        <Card href={`/catalogo/${id}/`} class="group/card h-full bg-brand-red p-2 text-on-red sm:p-4">
          <CatalogImage
            src={data.cover}
            alt=""
            width={400}
            height={400}
            widths={COVER_WIDTHS}
            sizes={sizes}
            priority={index === 0 ? "high" : index < EAGER_COUNT ? "eager" : "lazy"}
            class="aspect-square [&_img]:transition-transform [&_img]:duration-300 [&_img]:group-hover/card:scale-105"
          />
          <h2 class="mt-3 text-center text-base font-bold uppercase tracking-wide sm:mt-4 sm:text-lg">{data.name}</h2>
        </Card>
      </li>
    ))
  }
</ul>
