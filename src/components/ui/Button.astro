---
import { linkAttrs } from "../../lib/links";

interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a
  {...linkAttrs(href)}
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-xl border-2 border-on-red bg-brand-red px-5 py-2.5 text-lg font-bold text-on-red transition-colors hover:bg-brand-red-dark",
    className,
  ]}
>
  <slot />
</a>
