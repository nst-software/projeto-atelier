---
import { linkAttrs } from "../../lib/links";

interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a
  {...linkAttrs(href)}
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-full border-2 border-brand-beige-light bg-brand-red px-6 py-2.5 text-base font-bold uppercase tracking-wide text-on-red shadow-md transition hover:bg-brand-red-dark hover:shadow-lg active:scale-[0.98]",
    className,
  ]}
>
  <slot />
</a>
