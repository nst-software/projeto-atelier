---
import { linkAttrs } from "../../lib/links";

interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const classes = ["flex flex-col items-center rounded-card p-4 shadow-md", className];
---

{
  href ? (
    <a {...linkAttrs(href)} class:list={[classes, "transition hover:-translate-y-1 hover:shadow-xl"]}>
      <slot />
    </a>
  ) : (
    <div class:list={classes}>
      <slot />
    </div>
  )
}
